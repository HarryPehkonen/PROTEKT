# --- the gate's own footprint -------------------------------------------------
# tools/ci.sh's `tree` stage FAILS when any of these would show up as an untracked file,
# so this block is load-bearing, not tidiness. Keep it in step with .ci.env.example.
.ci-logs/
build/
build-*/
.ci.env

# NOT ignored on purpose: .ci/ holds the clang-tidy baseline
# (.ci/tidy-baseline.txt), which is meant to be committed.

# --- editors / OS -------------------------------------------------------------
.DS_Store
*.swp

# --- fuzzing ------------------------------------------------------------------
# fuzz/corpus/ IS committed on purpose: the seed corpus is the documented examples plus one
# deliberately invalid input, and it is what the suite feeds the fuzz entry point on every gate
# run. libFuzzer's own growing corpus belongs in a build directory (`-artifact_prefix=build/...`),
# never here -- the pristine stage caught this rule silently hiding the corpus from the repo.
fuzz/crash-*
fuzz/leak-*
fuzz/timeout-*
fuzz/oom-*
.aider*
