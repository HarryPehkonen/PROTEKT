HeaderFilterRegex: 'include/protekt/.*\.hpp$|tests/.*\.cpp$|src/.*\.cpp$'
# Value-only set, deliberately: real bug patterns and performance. Style lives in
# clang-format (a style family here fights the codebase's conventions and buries the
# signal). Same curation as the sibling C++ repos — see CODING_STANDARDS.md rule 4.
# Two exclusions, each for a reason the codebase can defend:
#  - bugprone-easily-swappable-parameters: this is a simulation made of adjacent ints (x, y,
#    tick, id) and the check cannot tell a bug from a design.
#  - cppcoreguidelines-avoid-magic-numbers: 262 of the 320 findings it produced were balance
#    constants and test literals. A named constant for every 8 in a test makes the test worse.
Checks: '-*,bugprone-*,-bugprone-easily-swappable-parameters,performance-*,cppcoreguidelines-*,-cppcoreguidelines-avoid-magic-numbers'

CheckOptions:
  - key: readability-function-cognitive-complexity.IgnoreMacros
    value: true
  - key: readability-function-cognitive-complexity.Threshold
    value: 30
